# Augmentum Configuration
# Copy to .env and customize as needed

# Server (API + UI served on same port)
AUGMENTUM_HOST=0.0.0.0
AUGMENTUM_PORT=6100
AUGMENTUM_LOG_LEVEL=INFO

# Docker port-publish interface. Default 127.0.0.1 — Augmentum is reachable
# only from the machine running it. Set to 0.0.0.0 to expose on the LAN
# (required if you want to access Augmentum from your phone, tablet, or
# another device on the same WiFi). Set to a specific IP (e.g. 192.168.1.10)
# to bind only that interface. NOTE: this is NOT the same as AUGMENTUM_HOST
# above — that's the listen address INSIDE the container; AUGMENTUM_BIND_HOST
# is the host-side interface Docker publishes the port on.
AUGMENTUM_BIND_HOST=127.0.0.1

# Extra TLS SANs baked into the self-signed cert Caddy mints. start.sh /
# start.bat auto-populate this from the host's RFC1918 IPv4 addresses
# (LAN + Tailscale CGNAT) when unset, so a fresh install accessed from
# a phone at https://<your-lan-ip>:6443 already covers the right names.
# Set explicitly only when auto-detection misses an address (custom
# bridge, multi-homed host, hostnames in /etc/hosts on your devices,
# etc.). Format: comma-separated openssl SAN tokens — DNS:foo,IP:1.2.3.4
# AUGMENTUM_TLS_EXTRA_SANS=

# HTTP→HTTPS redirect for browser navigations from non-loopback hosts.
# Default on. Disable only if you're terminating TLS at your own
# reverse proxy and serving HTTP to augmentum directly from LAN clients.
# AUGMENTUM_HTTPS_REDIRECT_LAN=true
# AUGMENTUM_HTTPS_REDIRECT_PORT=6443

# Ollama backend
AUGMENTUM_OLLAMA_BASE_URL=http://ollama:11434

# OpenAI-compatible backend
AUGMENTUM_OPENAI_API_KEY=
AUGMENTUM_OPENAI_BASE_URL=https://api.openai.com/v1

# Default backend
#   engine  — bundled llama-server subprocess (default, recommended)
#   openai  — OpenAI-compatible API (LM Studio, OpenRouter, official OpenAI, etc.)
#   ollama  — point at any Ollama instance (host or LAN) via AUGMENTUM_OLLAMA_BASE_URL
AUGMENTUM_DEFAULT_BACKEND=engine

# SearXNG
AUGMENTUM_SEARXNG_BASE_URL=http://searxng:8080
# SearXNG signs session cookies + CSRF tokens with this key. setup.sh /
# setup.bat auto-generate a fresh random value on first install and
# preserve it across re-runs; if you're configuring manually, generate
# your own (don't ship the placeholder):
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
# SEARXNG_SECRET=

# Sandboxed executor
AUGMENTUM_EXECUTOR_BASE_URL=http://executor:5000

# Data directory
AUGMENTUM_DATA_DIR=/data

# --- Inference Defaults (optional) ---
# AUGMENTUM_DEFAULT_TEMPERATURE=0.7
# AUGMENTUM_DEFAULT_TOP_P=0.9
# AUGMENTUM_DEFAULT_TOP_K=40
# AUGMENTUM_DEFAULT_NUM_CTX=4096

# --- UARF Analytical Tuning (optional) ---
# AUGMENTUM_UARF_MAX_BACKTRACKS=3
# AUGMENTUM_UARF_MAX_TOOL_CALLS_PER_PHASE=3
# AUGMENTUM_UARF_CONFIDENCE_THRESHOLD=0.5
# AUGMENTUM_UARF_PROACTIVE_SEARCH=true
# AUGMENTUM_UARF_PROACTIVE_MATH=true

# --- Narrative Tuning (optional) ---
# AUGMENTUM_NARRATIVE_CONTEXT_BUDGET=4000
# AUGMENTUM_NARRATIVE_AUTO_PERSIST=true

# --- Prompt Cache (optional) ---
# AUGMENTUM_PROMPT_CACHE_ENABLED=true
# AUGMENTUM_PROMPT_CACHE_MAX_ENTRIES=100
# AUGMENTUM_PROMPT_CACHE_TTL=3600

# --- Boot (optional) ---
# DBs larger than this run the startup PRAGMA quick_check as a background
# task instead of inline (inline measured 40s on a 1.5GB DB, all of it
# blocking first paint). Corruption handling is unchanged either way:
# recovery stamp + loud error pointing at the repair script.
# AUGMENTUM_QUICK_CHECK_INLINE_MAX_MB=256

# --- Self-edit / Workshop (locked off; not recommended) ---
# Self-edit is the subsystem that lets Augmentum modify its OWN source code.
# It is LOCKED on every normal install: the Workshop does not appear in the
# nav, the setting that enables it is not shown, and all /api/selfedit/*
# routes refuse. Setting this variable is the only way to make it available.
#
# Think carefully before you do. Its fitness gate runs compile, lint, tests
# and health checks — which proves a change didn't break the build, NOT that
# the change is correct. Edits can pass every check and still alter behavior
# in ways that only surface later (generated intent verbs are the known
# case). Work happens on isolated git branches and is reversible with
# `git revert`, but recovering a bad promotion may mean doing that by hand,
# from outside the app. Don't point it at a checkout holding uncommitted work.
#
# Unlocking only REVEALS the switch — self-edit still stays off until an admin
# enables it in Settings -> Diagnostics, and changes still wait for your
# verdict while autonomy is on the default "propose".
# AUGMENTUM_SELFEDIT_UNLOCK=1
#
# Where the loop finds the repo to edit (only used when unlocked). The dev
# bind-mount puts the source here; a writable .git is required or the loop
# stays a dry run.
# AUGMENTUM_SELFEDIT_REPO=/host-augmentum-src

# --- Image Generation (enabled by default, set false to disable) ---
# AUGMENTUM_IMAGE_ENABLED=true
# AUGMENTUM_IMAGE_MODEL_DIR=/data/image_models
# AUGMENTUM_IMAGE_OUTPUT_DIR=/data/image_output
# AUGMENTUM_IMAGE_DEFAULT_MODEL=
# AUGMENTUM_IMAGE_DEFAULT_STEPS=20
# AUGMENTUM_IMAGE_DEFAULT_CFG=7.0
# AUGMENTUM_IMAGE_DEFAULT_WIDTH=512
# AUGMENTUM_IMAGE_DEFAULT_HEIGHT=512
# AUGMENTUM_IMAGE_DEVICE=auto
# AUGMENTUM_IMAGE_PRECISION=auto
# AUGMENTUM_IMAGE_CIVITAI_API_KEY=
# AUGMENTUM_IMAGE_MAX_QUEUE_SIZE=10
# AUGMENTUM_IMAGE_VRAM_LIMIT=
# AUGMENTUM_IMAGE_WARMUP=true
# AUGMENTUM_IMAGE_DEFAULT_PRESET=

# --- Knowledge Packs (offline reference corpora; defaults all sensible) ---
# Master switch — set false to disable the entire pack subsystem.
# AUGMENTUM_KNOWLEDGE_PACKS_ENABLED=true
# Pack files live here; defaults to {data_dir}/knowledge.
# AUGMENTUM_KNOWLEDGE_PACKS_DIR=
# Per-mode injection toggles (which chat modes get pack content):
# AUGMENTUM_KNOWLEDGE_PACKS_PASSTHROUGH=true
# AUGMENTUM_KNOWLEDGE_PACKS_ANALYTICAL=true
# AUGMENTUM_KNOWLEDGE_PACKS_AGENTIC=true
# AUGMENTUM_KNOWLEDGE_PACKS_NARRATIVE=false
# Latency caches — see README "Performance" section for tradeoffs.
# AUGMENTUM_KNOWLEDGE_SEARCH_CACHE_ENABLED=true
# AUGMENTUM_KNOWLEDGE_SEARCH_CACHE_SIZE=256
# AUGMENTUM_KNOWLEDGE_SEARCH_CACHE_TTL_SECONDS=600
# AUGMENTUM_KNOWLEDGE_PASSAGE_CACHE_ENABLED=true
# AUGMENTUM_KNOWLEDGE_PASSAGE_CACHE_MAX_ARTICLES=5000
# Embedding/conversion (GPU optional):
# AUGMENTUM_KNOWLEDGE_EMBEDDING_USE_GPU=true
# AUGMENTUM_KNOWLEDGE_EMBEDDING_BATCH_SIZE=512
# Articles below this threshold get converted to augpack; larger stay ZIM.
# AUGMENTUM_KNOWLEDGE_ZIM_EMBED_THRESHOLD=200000

# --- Higgs TTS overlay (compose.higgs.yaml; PERSONAL / NON-COMMERCIAL) ---
# Defaults to portable Docker named volumes. Point these at an existing host
# cache to reuse already-downloaded weights / keep voice clones outside Docker.
# AUGMENTUM_HF_CACHE=~/.cache/huggingface
# AUGMENTUM_HIGGS_VOICES=~/.cache/sglang-omni/speakers

# --- Host memory backstop -------------------------------------------------
# Ceiling for the augmentum container, which also hosts the llama-server
# model slots. DELIBERATELY GENEROUS: it is a runaway backstop, not a budget.
# Reaching it is an immediate OOM kill that takes every model slot down at
# once (Docker Desktop on Windows runs cgroup v1, which has no throttle
# rung), so set it above your largest model's full resident footprint.
# Keep both values in sync — the second tells the app its own ceiling,
# because Docker exposes the cgroup read-only and unlimited-by-default.
# AUGMENTUM_MEM_LIMIT=32g
# AUGMENTUM_MEMORY_LIMIT_MIB=32768

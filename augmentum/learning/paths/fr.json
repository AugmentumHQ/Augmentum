            {"target": "J'ai vingt ans.", "en": "I'm twenty years old."},
            {"target": "Quel âge as-tu ? — J'ai dix-huit ans.", "en": "How old are you? — I'm eighteen."},
            {"target": "Mon ami a quinze ans.", "en": "My friend is fifteen."},
            {"target": "Elle a trois ans.", "en": "She is three years old."}

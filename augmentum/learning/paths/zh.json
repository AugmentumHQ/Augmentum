          "title": "Greetings & politeness",
          "theme": "social-opener",
          "goal": "Greet, thank, apologise, agree/refuse.",
          "vocab": [
            {"surface": "你好", "pos": "expr", "gloss": "hello (nǐ hǎo)"},
            {"surface": "您好", "pos": "expr", "gloss": "hello (formal, nín hǎo)"},
            {"surface": "你", "pos": "pron", "gloss": "you (nǐ)"},
            {"surface": "您", "pos": "pron", "gloss": "you (formal, nín)"},
            {"surface": "好", "pos": "adj", "gloss": "good (hǎo)"},
            {"surface": "再见", "pos": "expr", "gloss": "goodbye (zài jiàn)"},
            {"surface": "谢谢", "pos": "interj", "gloss": "thank you (xiè xie)"},
            {"surface": "不客气", "pos": "expr", "gloss": "you're welcome (bú kè qì)"},
            {"surface": "对不起", "pos": "interj", "gloss": "sorry (duì bu qǐ)"},
            {"surface": "没关系", "pos": "expr", "gloss": "no problem (méi guān xi)"},
            {"surface": "请", "pos": "verb", "gloss": "please / to invite (qǐng)"},
            {"surface": "是", "pos": "verb", "gloss": "to be / yes (shì)"},
            {"surface": "不", "pos": "adv", "gloss": "no / not (bù)"},
            {"surface": "好的", "pos": "expr", "gloss": "okay (hǎo de)"},
            {"surface": "早上好", "pos": "expr", "gloss": "good morning (zǎo shang hǎo)"},
            {"surface": "晚上好", "pos": "expr", "gloss": "good evening (wǎn shang hǎo)"},
            {"surface": "晚安", "pos": "expr", "gloss": "good night (wǎn ān)"}
          ],
          "phrases": [
            {"target": "你好，谢谢！", "en": "Hello, thank you!"},
            {"target": "对不起。没关系。", "en": "Sorry. — No problem."},
            {"target": "再见，晚安。", "en": "Goodbye, good night."}
          ],
          "grammar_note": "Tones change a word's meaning. 你 is 3rd tone (nǐ); 好 is also 3rd tone. When two 3rd tones meet, the first becomes 2nd: 'nǐ hǎo' → 'ní hǎo'.",
          "estimated_minutes": 10
        },

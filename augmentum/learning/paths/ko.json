            {"surface": "여보세요", "pos": "expr", "gloss": "hello (on the phone, yeoboseyo)"},
            {"surface": "잘 자요", "pos": "expr", "gloss": "good night (jal jayo)"},
            {"surface": "어서 오세요", "pos": "expr", "gloss": "welcome (to a shop/home, eoseo oseyo)"}

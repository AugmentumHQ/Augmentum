{
  "lang": "zh",
  "version": "1.0.0",
  "name": "Mandarin Tone Drill",
  "credits": "Hand-curated tone-pair training. Sandhi rules from standard textbooks (Yip Po-Ching & Don Rimmington, 'Chinese: A Comprehensive Grammar'; John DeFrancis, 'ABC Chinese-English Dictionary' tone notes). Tone-pair drill design follows Olle Linge's 'Hacking Chinese' tone-pair methodology. Minimal-pair vocabulary verified against CC-CEDICT.",
  "license": "CC BY 4.0",
  "units": [
    {
      "id": "zh-tone-01-four-tones",
      "title": "The four tones",
      "level": "HSK1",
      "goal": "Distinguish and produce all four lexical tones on a single syllable.",
      "explanation": "Mandarin uses 4 contour tones plus a neutral (toneless) tone. Tone 1: high-flat (ā) — hold steady, top of your speaking range. Tone 2: rising (á) — like a confused 'huh?'. Tone 3: low dipping (ǎ) — drop low, then rise (in isolation; often realized as a low fall in context). Tone 4: sharp falling (à) — like a clipped 'no!'. Same syllable + different tone = different word. Tone is part of the word's identity, not optional expressiveness.",
      "minimal_pairs": [
        {"syllable": "ma", "tones": {"mā 妈": "mother", "má 麻": "hemp / numb", "mǎ 马": "horse", "mà 骂": "to scold"}},
        {"syllable": "wen", "tones": {"wēn 温": "warm", "wén 文": "writing / language", "wěn 稳": "steady", "wèn 问": "to ask"}},
        {"syllable": "shu", "tones": {"shū 书": "book", "shú 熟": "cooked / familiar", "shǔ 鼠": "mouse / rat", "shù 树": "tree"}},
        {"syllable": "yan", "tones": {"yān 烟": "smoke", "yán 盐": "salt", "yǎn 眼": "eye", "yàn 燕": "swallow (bird)"}}
      ],
      "drill": [
        "Listen and identify the tone number (1-4) on each syllable.",
        "Produce 'mā má mǎ mà' clearly, exaggerating the contour at first.",
        "Record yourself saying 妈 and 骂 back-to-back; check that 1 stays flat and 4 falls sharply."
      ]
    },
    {
      "id": "zh-tone-02-sandhi-third",
      "title": "Third-tone sandhi",
      "level": "HSK1",
      "goal": "Apply the rule that two 3rd tones in sequence become 2nd + 3rd.",
      "explanation": "When two 3rd-tone syllables come together, the FIRST one is pronounced as a 2nd tone. Pinyin spelling stays unchanged (still written 'nǐ hǎo'); pronunciation shifts to 'ní hǎo'. The rule chains: 我也很好 (wǒ yě hěn hǎo, 3-3-3-3) is pronounced 'wó yé hén hǎo'. In a longer string the speaker re-applies the rule from the end back to the front, but for beginners the practical rule is just: '3-3 → 2-3'.",
      "pattern_examples": [
        {"written": "nǐ hǎo 你好", "spoken": "ní hǎo", "gloss": "hello"},
        {"written": "wǒ hěn 我很", "spoken": "wó hěn", "gloss": "I'm very… (followed by adj)"},
        {"written": "hěn hǎo 很好", "spoken": "hén hǎo", "gloss": "very good"},
        {"written": "wǒ xiǎng 我想", "spoken": "wó xiǎng", "gloss": "I want / I think"},
        {"written": "shuǐ guǒ 水果", "spoken": "shuí guǒ", "gloss": "fruit"},
        {"written": "yǔ fǎ 语法", "spoken": "yú fǎ", "gloss": "grammar"},
        {"written": "kě yǐ 可以", "spoken": "ké yǐ", "gloss": "may / can"},
        {"written": "lǎo bǎn 老板", "spoken": "láo bǎn", "gloss": "boss"}
      ],
      "drill": [
        "Say 你好 ten times — keep the first syllable rising.",
        "Read aloud: 我也很好。 The first three syllables all shift up; only the final 好 stays as a true 3rd.",
        "Listen for the difference between 你好 (rising-low) and 你的 (low-neutral). The first syllable is a different tone in the spoken form."
      ]
    },
    {
      "id": "zh-tone-03-sandhi-bu",
      "title": "不 (bù) sandhi",
      "level": "HSK1",
      "goal": "Pronounce 不 as 2nd tone before a 4th-tone syllable.",
      "explanation": "不 is normally 4th tone (bù). Before another 4th-tone syllable it becomes 2nd tone (bú). Like 3rd-tone sandhi, the pinyin spelling sometimes reflects this (textbooks vary). The rule is purely pronunciation; meaning is unchanged. Before tones 1/2/3 and neutral, 不 stays as 4th tone.",
      "pattern_examples": [
        {"written": "bù + 4th: bù kàn 不看", "spoken": "bú kàn", "gloss": "doesn't watch"},
        {"written": "bù + 4th: bù qù 不去", "spoken": "bú qù", "gloss": "doesn't go"},
        {"written": "bù + 4th: bù shì 不是", "spoken": "bú shì", "gloss": "isn't"},
        {"written": "bù + 4th: bù yào 不要", "spoken": "bú yào", "gloss": "doesn't want"},
        {"written": "bù + 4th: bù duì 不对", "spoken": "bú duì", "gloss": "incorrect"},
        {"written": "bù + 1st: bù chī 不吃", "spoken": "bù chī (unchanged)", "gloss": "doesn't eat"},
        {"written": "bù + 2nd: bù lái 不来", "spoken": "bù lái (unchanged)", "gloss": "doesn't come"},
        {"written": "bù + 3rd: bù hǎo 不好", "spoken": "bù hǎo (unchanged)", "gloss": "not good"}
      ],
      "drill": [
        "Contrast pair: 不吃 (bù chī, 4-1) vs 不去 (bú qù, 2-4).",
        "Read the negative answers to common questions: 不是。不对。不要。 All shift to 2nd tone.",
        "Listen-check: if the next syllable falls, 不 rises."
      ]
    },
    {
      "id": "zh-tone-04-sandhi-yi",
      "title": "一 (yī) sandhi",
      "level": "HSK1",
      "goal": "Pronounce 一 as 4th tone before tones 1/2/3 and as 2nd tone before 4th.",
      "explanation": "一 has three pronunciations depending on context. Citation (counting in isolation, or in ordinal/fixed expressions): 1st tone (yī). Before a 4th-tone or neutral-fallen-from-4th syllable: 2nd tone (yí). Before a 1st, 2nd, or 3rd tone: 4th tone (yì). Like 不-sandhi, this is pronunciation only; characters and meaning never change.",
      "pattern_examples": [
        {"written": "yī (citation): yī èr sān 一二三", "spoken": "yī èr sān", "gloss": "one two three (counting)"},
        {"written": "yī + 1st → yì: yì tiān 一天", "spoken": "yì tiān", "gloss": "one day"},
        {"written": "yī + 2nd → yì: yì nián 一年", "spoken": "yì nián", "gloss": "one year"},
        {"written": "yī + 3rd → yì: yì běn 一本", "spoken": "yì běn", "gloss": "one (book)"},
        {"written": "yī + 4th → yí: yí gè 一个", "spoken": "yí gè", "gloss": "one (general)"},
        {"written": "yī + 4th → yí: yí cì 一次", "spoken": "yí cì", "gloss": "one time / once"},
        {"written": "yī + 4th → yí: yí yàng 一样", "spoken": "yí yàng", "gloss": "the same"},
        {"written": "yī + 4th → yí: yí dìng 一定", "spoken": "yí dìng", "gloss": "certainly"},
        {"written": "ordinal — citation: dì yī 第一", "spoken": "dì yī", "gloss": "first (ordinal — no sandhi)"}
      ],
      "drill": [
        "Practice 一个 (yí gè) until the 'one' sounds clearly rising, not flat.",
        "Count out 一二三 (citation) vs 一年, 一天, 一个 (sandhi). All four come up in the first week of class.",
        "Trap: 第一 keeps citation tone because it's ordinal — 一 isn't acting as a counter here."
      ]
    },
    {
      "id": "zh-tone-05-neutral-tone",
      "title": "The neutral tone",
      "level": "HSK1",
      "goal": "Produce unstressed, light final syllables on common particles and reduplicated words.",
      "explanation": "The neutral tone (轻声 qīng shēng) is short, unstressed, and low in volume. It carries no contour of its own; its pitch is determined by the preceding syllable. Written without a tone mark in pinyin. Common neutral-tone categories: grammatical particles (的 de, 了 le, 着 zhe, 吗 ma, 呢 ne, 吧 ba), the second syllable of reduplicated kinship terms (爸爸 bàba, 妈妈 māma), directional and aspect markers (来 in 起来, 去 in 出去), and a handful of high-frequency lexical items (东西 dōngxi, 朋友 péngyou, 谢谢 xièxie).",
      "pattern_examples": [
        {"written": "妈妈 māma", "neutral": "second 'ma' is light, low, unstressed", "gloss": "mom"},
        {"written": "爸爸 bàba", "neutral": "second 'ba' falls light after the sharp 4th", "gloss": "dad"},
        {"written": "谢谢 xièxie", "neutral": "second 'xie' is barely there", "gloss": "thanks"},
        {"written": "朋友 péngyou", "neutral": "'you' loses its tone after 2nd", "gloss": "friend"},
        {"written": "东西 dōngxi", "neutral": "'xi' is neutral; with 3rd-tone xī it means 'east-west' (direction)", "gloss": "thing (vs direction)"},
        {"written": "我的 wǒ de", "neutral": "possessive particle de", "gloss": "mine"},
        {"written": "吃了 chī le", "neutral": "perfective particle le", "gloss": "ate"},
        {"written": "好吗 hǎo ma", "neutral": "question particle ma", "gloss": "okay?"},
        {"written": "走吧 zǒu ba", "neutral": "suggestion particle ba", "gloss": "let's go"}
      ],
      "drill": [
        "Compare 东西 (dōngxi — 'thing', neutral) with 东西 (dōngxī — 'east-west', 1+1). The tone of the second syllable changes the meaning.",
        "Read 妈妈, 爸爸, 哥哥, 姐姐, 弟弟, 妹妹 in one breath; each second syllable should fall short.",
        "Listen for the neutral 了 — it's a tiny tail on the verb, never a stressed beat."
      ]
    },

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Augmentum fullscreen theme.

      Inherits from Theme.AppCompat.NoActionBar so AppCompatActivity's
      setContentView() works without crashing. windowFullscreen drops
      the system status bar so the WebView owns the entire frame —
      this is a TV receiver, not a phone app.
    -->
    <style name="Theme.Augmentum.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>

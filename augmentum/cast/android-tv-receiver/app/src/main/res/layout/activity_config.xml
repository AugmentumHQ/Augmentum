<?xml version="1.0" encoding="utf-8"?>
<!--
  Config screen — first-launch URL entry.

  Designed for the D-pad world: large fonts, generous spacing, one
  focusable input + one focusable button. Default focus lands on the
  input; pressing OK on a D-pad opens the system keyboard.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:padding="64dp"
              android:background="#0a0c12">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_title"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#f0f0f0"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_instructions"
        android:textSize="18sp"
        android:textColor="#888"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <EditText
        android:id="@+id/config_url_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/config_url_hint"
        android:inputType="textUri"
        android:textSize="22sp"
        android:textColor="#f0f0f0"
        android:textColorHint="#666"
        android:padding="20dp"
        android:background="#1a1d24"
        android:layout_marginBottom="20dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:imeOptions="actionDone" />

    <Button
        android:id="@+id/config_save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_save"
        android:textSize="20sp"
        android:textColor="#0a0c12"
        android:backgroundTint="#7a86ff"
        android:paddingHorizontal="40dp"
        android:paddingVertical="14dp"
        android:focusable="true" />

    <TextView
        android:id="@+id/config_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#f88"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

</LinearLayout>

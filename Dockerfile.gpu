# GPU-enabled build — NVIDIA CUDA 12.8 + cuDNN 9 runtime base.
# Provides libcublas, libcusparse, libcurand, libcudnn etc. that
# bitsandbytes, torch, and onnxruntime-gpu need at runtime.
# Use via compose.gpu.yaml.
# NOTE: Must match PyTorch's bundled CUDA version (currently cu128).

# ---- llama-server: pre-built image (only rebuilds on version bump) ----
# Build once locally:
#   docker build -t augmentum-llama-server -f Dockerfile.llama-server .
# Rebuild on llama.cpp upgrade:
#   docker build -t augmentum-llama-server --build-arg LLAMA_CPP_VERSION=b5500 -f Dockerfile.llama-server .
#
# CI passes ``--build-arg LLAMA_SERVER_IMAGE=ghcr.io/augmentumhq/augmentum-llama-server:<version>``
# so the published GPU variant pulls the binary from GHCR instead of needing a
# local build. Default keeps the dev/local workflow working unchanged.
ARG LLAMA_SERVER_IMAGE=augmentum-llama-server:latest
FROM ${LLAMA_SERVER_IMAGE} AS llama-builder

# ---- Runtime stage ----
# Base image pinned to a specific digest — see Dockerfile header for
# the rotation procedure (scripts/upgrade_base_images.sh).
FROM nvidia/cuda:13.3.1-cudnn-runtime-ubuntu22.04@sha256:d613b00c36d11fc3acc8923ef5d7672d30f469c1a9049906fbd993dd2ba8155f

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install Python 3.11, curl, gosu, ffmpeg, plus Chrome (headless
# verify for the App Builder's `app_builder_use_browser_verify` setting
# — see augmentum/tools/application_cdp.py). ~150MB but reused across
# every build verify run. Ubuntu's chromium-browser package is a snap stub here.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev \
        ca-certificates curl gosu ffmpeg gcc bzip2 git && \
    curl -fsSL -o /tmp/google-chrome.deb \
        https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && \
    apt-get install -y --no-install-recommends /tmp/google-chrome.deb && \
    rm -f /tmp/google-chrome.deb && \
    # Set python3.11 as default
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    # Install pip
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 && \
    rm -rf /var/lib/apt/lists/*

# cloudflared — the throwaway quick-tunnel binary the Connect invite "Anywhere"
# tier spawns to stand up an ephemeral, anonymous public door for an
# out-of-network guest (torn down on claim). Zero-config: reachability.py
# auto-detects it on PATH, so bundling it makes the public tier work out of the
# box. Pinned + verified — scripts/smoke_cloudflared.py runs a REAL quick tunnel
# against this exact version.
ARG CLOUDFLARED_VERSION=2026.7.2
RUN curl -fsSL -o /usr/local/bin/cloudflared \
      "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-amd64" && \
    chmod +x /usr/local/bin/cloudflared && \
    /usr/local/bin/cloudflared --version

WORKDIR /app

# Create non-root user and data directories
RUN useradd -m -u 1000 augmentum && \
    mkdir -p /data/image_models /data/image_output /data/models && \
    chown -R augmentum:augmentum /data

# llama-server binary + shared libraries from build stage (engine v2)
COPY --from=llama-builder /usr/local/bin/llama-server /usr/local/bin/llama-server
# llama-lookup-create accompanies it: the Observation Substrate exporter
# (augmentum/observation/exporter.py) shells out to it lazily on model
# swap to produce the per-model --lookup-cache-static file from L0
# observations. Roughly 5MB binary; harmless on systems where the
# substrate feature flag stays off.
COPY --from=llama-builder /usr/local/bin/llama-lookup-create /usr/local/bin/llama-lookup-create
COPY --from=llama-builder /usr/local/lib/lib*.so /usr/local/lib/
RUN ldconfig

# ---- Heavy deps layer (rarely changes, ~20 min to install) ----
# Install the big packages directly so this layer survives pyproject.toml edits.
# Only busted when you upgrade torch/diffusers/transformers versions.
RUN pip install --no-cache-dir \
      torch==2.7.0 torchvision==0.22.0 --index-url https://download.pytorch.org/whl/cu128 && \
    pip install --no-cache-dir \
      diffusers accelerate transformers safetensors sentencepiece protobuf && \
    pip install --no-cache-dir webrtcvad-wheels resemblyzer --no-deps && \
    pip install --no-cache-dir librosa soundfile && \
    pip install --no-cache-dir hf_transfer

# ---- Project deps layer (changes when requirements.lock changes) ----
#
# Reproducible-build defense: requirements.lock is a fully hash-locked
# manifest derived from uv.lock. ``--require-hashes`` makes pip refuse
# any wheel whose sha256 doesn't match — so a PyPI compromise that
# re-publishes a transitive dep under the same version can't slip
# untrusted bytes into the image. Regenerate via
# ``./scripts/regen_requirements_lock.sh`` after editing pyproject.toml.
#
# The heavy-deps layer above installed torch / xformers / bitsandbytes
# from PyTorch's CUDA index (those wheels don't live on PyPI and so
# aren't carried by the lockfile). pip sees them already-satisfied at
# the requested version and skips them on this pass — no hash conflict.
#
# Then ``pip install --no-deps .`` installs the augmentum package itself
# without re-resolving deps (everything's already in place from the
# locked install). The two steps deliberately separate "third-party
# graph from a locked manifest" from "this project's own code".
COPY requirements.lock pyproject.toml README.md ./
COPY augmentum/__init__.py augmentum/__init__.py
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --require-hashes --retries 5 --timeout 300 -r requirements.lock && \
    pip install --no-deps .

# ---- ONNX Runtime: swap CPU build for GPU build ----
# pyproject.toml lists the CPU ``onnxruntime`` so plain ``pip install -e .``
# works on CPU-only hosts. On the GPU image we swap it for ``onnxruntime-gpu``
# AFTER the pyproject install — both packages share the ``onnxruntime`` import
# path and conflict if installed together (they overwrite each other's files
# depending on install order). Earlier versions of this Dockerfile installed
# onnxruntime-gpu BEFORE the pyproject install, which silently re-installed
# the CPU build on top and lost CUDAExecutionProvider. The convert_worker's
# GPU detection depends on this swap landing.
RUN pip uninstall -y onnxruntime && \
    pip install --no-cache-dir onnxruntime-gpu \
      --extra-index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/

# Pre-download WeSpeaker speaker verification model (~28MB)
# The default CDN (cos.ap-shanghai) is unreliable outside China.
# Download from HuggingFace mirror instead, then place where wespeakerruntime expects it.
RUN mkdir -p /home/augmentum/.wespeaker/en && \
    curl -fsSL -o /home/augmentum/.wespeaker/en/voxceleb_resnet34_LM.onnx \
      "https://huggingface.co/openspeech/wespeaker-models/resolve/main/voxceleb_resnet34_LM.onnx" \
      --retry 3 --retry-delay 2 || \
    curl -fsSL -o /home/augmentum/.wespeaker/en/voxceleb_resnet34_LM.onnx \
      "https://wespeaker-1256283475.cos.ap-shanghai.myqcloud.com/models/voxceleb/voxceleb_resnet34_LM.onnx" \
      --retry 2 || true && \
    chown -R augmentum:augmentum /home/augmentum/.wespeaker

# Pre-download DTLN speech enhancement models (~3.7MB)
RUN mkdir -p /home/augmentum/.dtln && \
    curl -fsSL -o /home/augmentum/.dtln/model_1.onnx \
      "https://raw.githubusercontent.com/breizhn/DTLN/master/pretrained_model/model_1.onnx" \
      --retry 3 --retry-delay 2 && \
    curl -fsSL -o /home/augmentum/.dtln/model_2.onnx \
      "https://raw.githubusercontent.com/breizhn/DTLN/master/pretrained_model/model_2.onnx" \
      --retry 3 --retry-delay 2 && \
    chown -R augmentum:augmentum /home/augmentum/.dtln || \
    echo "WARNING: DTLN model download failed — neural denoising will be unavailable"

# Pre-download Kokoro TTS models — INT8 (88MB) + voices (27MB)
RUN mkdir -p /home/augmentum/.kokoro && \
    curl -fSL --connect-timeout 30 --max-time 300 \
      -o /home/augmentum/.kokoro/kokoro-v1.0.int8.onnx \
      "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.int8.onnx" \
      --retry 3 --retry-delay 5 && \
    curl -fSL --connect-timeout 30 --max-time 300 \
      -o /home/augmentum/.kokoro/voices-v1.0.bin \
      "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin" \
      --retry 3 --retry-delay 5

# FP16 model (169MB, optional — higher quality). Separate layer so a timeout
# doesn't block INT8 + voices. Verify download size to catch truncation.
RUN curl -fSL --connect-timeout 30 --max-time 600 \
      -o /home/augmentum/.kokoro/kokoro-v1.0.fp16.onnx \
      "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.fp16.onnx" \
      --retry 5 --retry-delay 10 && \
    FP16_SIZE=$(wc -c < /home/augmentum/.kokoro/kokoro-v1.0.fp16.onnx 2>/dev/null || echo 0) && \
    if [ "$FP16_SIZE" -lt 100000000 ]; then \
      echo "WARNING: FP16 model download appears truncated ($FP16_SIZE bytes), removing" && \
      rm -f /home/augmentum/.kokoro/kokoro-v1.0.fp16.onnx; \
    fi ; \
    chown -R augmentum:augmentum /home/augmentum/.kokoro

# Pocket TTS (Kyutai) — CPU TTS engine, ~100M params / ~236MB weights, 6
# languages (english/french/german/italian/portuguese/spanish), 8 named
# voices, voice cloning from short reference clips. Mimi codec.
# Disabled by default; AUGMENTUM_TTS_POCKET_BUILTIN=true enables it.
# Install the pip package + pre-cache the default English weights so the
# first runtime synth doesn't pay the ~236MB download cost.
RUN pip install --no-cache-dir pocket-tts || \
    echo "pocket-tts install failed — engine stays disabled"
RUN mkdir -p /home/augmentum/.cache/pocket_tts && \
    python -c "from pocket_tts import TTSModel; TTSModel.load_model()" && \
    chown -R augmentum:augmentum /home/augmentum/.cache/pocket_tts || \
    echo "Pocket TTS weight pre-cache failed — first runtime synth will download (~236MB)"

# Vision on GPU boxes is served by the CLASSIFIER SLOT (Gemma-4-E2B/E4B with
# its mmproj) — no separate vision model is baked here anymore. The retired
# SmolVLM sibling now exists ONLY as a lazy CPU fallback for no-GPU
# deployments; that small CPU VL (SmolVLM2-500M by default) is provisioned on
# demand into /models/vision, not baked into the GPU image. See augmentum/
# vision/ and the managed classifier slot (augmentum/models/classifier_slot.py).

# Pre-download Moonshine STT model (~1 GB)
RUN python -m moonshine_voice.download --language en 2>/dev/null || \
    echo "Moonshine model will download on first voice call"

# Pre-download nltk data used by g2p_en (phoneme-driven lip sync).
# averaged_perceptron_tagger ~2 MB + cmudict ~3 MB. Avoids first-call
# download stall (g2p_en lazily fetches both on first invocation).
# Explicit download_dir is required — NLTK_DATA env var alone does not
# auto-create the target directory, which silently strands the download.
RUN mkdir -p /home/augmentum/nltk_data && \
    python -c "import nltk; nltk.download('averaged_perceptron_tagger', download_dir='/home/augmentum/nltk_data'); nltk.download('cmudict', download_dir='/home/augmentum/nltk_data')" && \
    chown -R augmentum:augmentum /home/augmentum/nltk_data || \
    echo "g2p_en nltk data will download on first lip-sync call"

# Pre-download SmartTurn v3.2 turn-completion model (~8MB ONNX)
# Lives outside /data so the volume mount can't shadow it.
RUN mkdir -p /home/augmentum/.smart-turn && \
    curl -fSL --connect-timeout 30 --max-time 60 \
      -o /home/augmentum/.smart-turn/smart-turn-v3.2-cpu.onnx \
      "https://huggingface.co/pipecat-ai/smart-turn-v3/resolve/main/smart-turn-v3.2-cpu.onnx" \
      --retry 3 --retry-delay 5 && \
    chown -R augmentum:augmentum /home/augmentum/.smart-turn || \
    echo "SmartTurn model will download on first voice call"

# Pre-download the nomic embedding model (~140MB) used by memory + RAG.
RUN HOME=/home/augmentum python -c "from fastembed import TextEmbedding; TextEmbedding('nomic-ai/nomic-embed-text-v1.5-Q')" && \
    chown -R augmentum:augmentum /home/augmentum/.cache

# Pre-download the rembg background-removal model (~170MB).
RUN U2NET_HOME=/home/augmentum/.u2net python -c "from rembg import new_session; new_session('isnet-general-use')" && \
    chown -R augmentum:augmentum /home/augmentum/.u2net

# Copy application code and UI
COPY augmentum/ augmentum/
COPY ui/ ui/
COPY config/ config/
COPY .augmentum/powers/ .augmentum/powers/
COPY .claude/skills/ .claude/skills/
COPY ui/lib/bundled-avatars/ /data/bundled-avatars/

# Entrypoint runs as root to fix perms once, then drops to augmentum
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 6100

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "augmentum.main"]

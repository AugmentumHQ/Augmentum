*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Vendored EmulatorJS bundle (296MB; fetched via scripts/vendor_emulator_js.sh).
# Keep README + VERSION + LICENSE under source control so the layout is
# discoverable; ignore the data/ directory which is the heavy WASM payload.
ui/lib/emulator-js/data/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment
.env

# Data
data/
.data/
*.db
*.sqlite

# Encryption key — NEVER commit
.secret_key

# Coverage
htmlcov/
.coverage
.coverage.*

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Setup wizard output
.augmentum.conf

# Cloned service repos (setup wizard) — ignore everything under services/
# EXCEPT first-party sidecars we ship in-repo (e.g. the CSM TTS service).
services/*
!services/sesame-csm/

# Local agent / tooling working dirs (Claude Code, brainstorm scratch).
# Ignore .augmentum's contents but keep the directory itself unignored so
# the powers exception below can re-include its tree (git can't re-include
# anything under an excluded parent directory).
.augmentum/*
# Native power packs ship with the image: Dockerfile.gpu COPYs
# .augmentum/powers/ at build time and settings.js + test_power_routes.py
# treat them as shipped content. Without this exception, a fresh clone
# fails the docker build on the COPY line.
!.augmentum/powers/
.superpowers/
.claude/worktrees/
.claude/scheduled_tasks.lock

# Per-user Claude Code permissions (settings.json is the shared one)
.claude/settings.local.json

# Test outputs
test_run.xml
tests/eval_results/
*.log

# Captured runtime debug log (uvicorn access dump dropped at repo root by
# `start.bat 2> _dlog.txt` style invocations — pure runtime, never source).
_dlog.txt

# Per-machine audit trend history (the shared truth is audit_baseline.json)
.claude/skills/augmentum-dev/references/audit_history.jsonl

# Audit-script orphan inventory (regenerated by dead_code.py; per-machine)
.claude/skills/augmentum-dev/orphans_by_file.json

# augmentum-dev codebase model cache (rebuilt opportunistically; never
# committed because sqlite files don't diff and would churn constantly).
.augmentum-dev-cache/

# Local audit/bench output (regenerated; per-machine)
.augmentum-bench/

# Crash dumps (Cygwin/MSYS bash)
*.stackdump

# Throwaway debugging scripts (underscore-prefixed convention)
scripts/_*.py

# Affordance-mining pipeline regenerable artifacts + third-party reference packs
poses/external/
poses/affordance-screenshots/
poses/synthesized-screenshots/
poses/idle-frames/
poses/vrma/
poses/*.bak
poses/*.before-cleanup

# Body-atlas + contact-event bake outputs (regenerable via
# scripts/bake_body_atlases.py from the bundled VRM files). Each
# atlas is ~50-60 MB and contact-events.jsonl runs ~40+ MB —
# committing them bloats history with content-addressed binary-ish
# JSON that doesn't diff usefully.
poses/body-atlas-*.json
poses/body-atlas-*.json.gz
poses/contact-events.jsonl

# Vendored VRM viewer used as a one-time studio reference (not for distribution)
refvrm/

# Personal design mockups — local reference only, not part of the shipped UI
ui/mockups/

# Windows reserved device-name artifacts (accidental `> CON` shell redirects)
CON

tests/live/cardsmith_audits/


# ─────────────────────────────────────────────────────────────────────────────
# Claude Code → Local Augmentum routing config
# SOURCED ONLY by ~/.augmentum/claude-aug.sh — NEVER sourced globally.
# Generated by scripts/claude-aug/install.{ps1,sh}
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. API key (from Augmentum UI: Settings → API Keys) ──────────────────
export AUGMENTUM_API_KEY={{API_KEY}}

# ── 2. Augmentum server address ──────────────────────────────────────────
export ANTHROPIC_BASE_URL="{{BASE_URL}}"

# ── 3. Your local model (main loop) ──────────────────────────────────────
export ANTHROPIC_MODEL="{{MAIN_MODEL}}"

# ── 4. Small/fast model for subagents ────────────────────────────────────
export ANTHROPIC_SMALL_FAST_MODEL="{{SMALL_MODEL}}"

# ── 5. Augmentum-side model aliases (for subagent claude-* requests) ─────
# CC hardcodes "claude-sonnet-*", "claude-haiku-*" etc. for helper agents.
# ** These must ALSO be in Augmentum's .env so the Docker container sees
#    them (the installer reminds you). **
export AUGMENTUM_ANTHROPIC_ALIAS_HAIKU="{{SMALL_MODEL}}"
export AUGMENTUM_ANTHROPIC_ALIAS_SONNET="{{SMALL_MODEL}}"
export AUGMENTUM_ANTHROPIC_ALIAS_OPUS="{{MAIN_MODEL}}"
export AUGMENTUM_ANTHROPIC_ALIAS_DEFAULT="{{MAIN_MODEL}}"

# ── 5b. Model profiles for `claude-aug --profile NAME` ───────────────────
# Format: "MAIN_MODEL SMALL_MODEL" (small optional, defaults to main).
export AUGMENTUM_PROFILE_DEEP="{{MAIN_MODEL}} {{MAIN_MODEL}}"
export AUGMENTUM_PROFILE_FAST="{{SMALL_MODEL}} {{SMALL_MODEL}}"
export AUGMENTUM_PROFILE_MIXED="{{MAIN_MODEL}} {{SMALL_MODEL}}"

# ── 6. Wire it up ────────────────────────────────────────────────────────
export ANTHROPIC_API_KEY="${AUGMENTUM_API_KEY}"
export ANTHROPIC_CUSTOM_HEADERS="X-Augmentum-Harness: claude_code"
